# Public site URL — used for canonical URLs, sitemap, Open Graph, schema
NEXT_PUBLIC_SITE_URL=https://mountivawater.com

# Wholesale enquiry routing (server-side only).
# Leave WHOLESALE_WEBHOOK_URL empty in local dev — submissions are validated
# and logged to the server console instead of being forwarded.
WHOLESALE_WEBHOOK_URL=
WHOLESALE_NOTIFY_EMAIL=wholesale@mountivawater.com

# Optional analytics / verification
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
GOOGLE_SITE_VERIFICATION=
